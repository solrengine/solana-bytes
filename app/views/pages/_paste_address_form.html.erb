<%# Full-width paste-address form. Submits to /lookup which redirects to
    /accounts/:address; Turbo Frame target loads the decoded view inline.
    Stimulus address-form controller handles client-side base58 validation
    and toggles the submit button enabled state. %>
<div class="mb-3" data-controller="address-form">
  <%= form_with url: "/lookup", method: :post, data: { turbo_frame: "account_result", action: "submit->address-form#submit" } do |f| %>
    <div class="flex flex-col sm:flex-row gap-2">
      <%= f.text_field :address,
            placeholder: "Paste a Solana account address...",
            class: "pixel-input flex-1",
            style: "font-size:11px;padding:12px 14px",
            autocomplete: "off",
            "data-form-type": "other",
            "data-lpignore": "true",
            "data-1p-ignore": "true",
            data: { address_form_target: "input", action: "input->address-form#validate" } %>
      <button
        type="submit"
        disabled="disabled"
        data-address-form-target="submit"
        class="pixel-btn min-h-[44px] sm:min-h-0 sm:w-auto"
        style="font-size:11px;padding:12px 24px;opacity:0.4;cursor:not-allowed"
      >
        <%= pixel_icon(:magnifier, size: 12) %> Visualize
      </button>
    </div>
    <p data-address-form-target="error" class="text-red-400 mt-2" style="display:none;font-size:10px"></p>
  <% end %>

  <%# Examples row — clickable chips for the four most representative
      account types. Each chip links to /accounts/<example_address> via
      Turbo Frame so the visualizer loads inline, same as form submission. %>
  <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-gray-500" style="font-size:9px">
    <% [
      ["EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v", "USDC Mint"],
      ["ALZv1FW3Bc5uRtci2UHnYS34DEWCmfkN5btEYDKms9yU", "Jupiter USDC"],
      ["CbrKVVDv6irzm4SYv8YnhJkN6wCTnYw9S7SqdwavCrRt", "Stake Account"],
      ["GbL3KvBBRXJArvft1KQPMUworMDormXNfo97hkbftsT5", "Jupiter LUT"]
    ].each do |addr, label| %>
      <%= link_to "/accounts/#{addr}",
            data: { turbo_frame: "account_result" },
            class: "pixel-tab",
            style: "padding:5px 10px;font-size:9px;text-decoration:none" do %>
        <%= label %>
      <% end %>
    <% end %>
  </div>
</div>
