<%# Type grid (U8): the six mockup-fixed cards. Replaces _type_picker.html.erb
    which iterated all 11 AccountTaxonomy entries. The five entries not in
    this grid (Multisig, Token-2022 Mint/Account, BPF Upgradeable, ELF
    Bytecode, plus any future entries) remain discoverable via the
    "Browse all account types →" link below the grid → /learn (404 until
    U15 ships the route).

    Cards link to /accounts/<example_address> for now; U15 swaps them to
    /learn/<slug> once the Learn pages exist. %>
<%# U22: card links now go to /learn/<category>/<slug> via entry.learn_path. %>
<% mockup_type_names = ["Mint", "Token Account", "Stake Account", "Vote Account", "Token Metadata", "Address Lookup Table"]
   mockup_entries = mockup_type_names.map { |name| AccountTaxonomy.flat_entries.find { |e| e.name == name } }.compact %>
<div class="mb-20">
  <h2 class="text-center text-white mb-3" style="font-size:20px;text-shadow:3px 3px 0 #4c1d95">
    Explore common account types
  </h2>
  <p class="text-center text-gray-500 mb-8" style="font-size:10px">
    Hand-picked Solana account layouts, decoded byte by byte.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% mockup_entries.each do |entry| %>
      <%# U15 swap: link target moves from /accounts/<addr> to /learn/<slug>
          now that the Learn pages exist. Turbo-frame attribute removed —
          /learn pages are standalone, not a Turbo Frame destination. %>
      <%= link_to entry.learn_path,
            class: "pixel-card flex flex-col hover:border-purple-500 transition-colors",
            style: "padding:14px;text-decoration:none" do %>
        <h3 class="text-white mb-1" style="font-size:13px">
          <%= entry.name %>
        </h3>
        <p class="text-gray-500 mb-3" style="font-size:9px">
          <%= entry.program_label %><% if entry.size %> &middot; <%= entry.size %> bytes<% end %>
        </p>
        <p class="text-gray-400 mb-3" style="font-size:10px;line-height:1.6;flex:1">
          <%= truncate(entry.description, length: 110) %>
        </p>
        <p class="mt-auto text-purple-400" style="font-size:10px">
          Explore <span aria-hidden="true">&rarr;</span>
        </p>
      <% end %>
    <% end %>
  </div>

  <%# Browse-all link: preserves discoverability of the five taxonomy
      entries not surfaced in the 6-card grid. Targets /learn (404 until
      U15 ships the route + redirect). %>
  <div class="text-center mt-8">
    <%= link_to "/learn",
          class: "text-gray-400 hover:text-purple-300 inline-flex items-center gap-2",
          style: "font-size:10px",
          data: { turbo: false } do %>
      <%= pixel_icon(:lock, size: 12) %> Browse all account types &rarr;
    <% end %>
  </div>

  <%# Byte Challenge CTA — preserved from _type_picker.html.erb so the
      live play-count social proof and game entry point both stay. %>
  <% challenges_count = local_assigns[:stats] && stats[:total_challenges].to_i %>
  <div class="text-center mt-4">
    <%= link_to "/challenges",
          class: "pixel-btn pixel-btn-secondary inline-flex items-center gap-2",
          style: "font-size:10px;padding:10px 18px",
          data: { turbo: false } do %>
      <%= pixel_icon(:target, size: 14) %>
      <% if challenges_count.to_i > 0 %>
        <span><%= number_with_delimiter(challenges_count) %> challenges played &mdash; can you beat them?</span>
      <% else %>
        <span>Test your eye &mdash; find the mint authority in 165 bytes</span>
      <% end %>
      <span>&rarr;</span>
    <% end %>
  </div>
</div>
