<%# Two info cards below the hero (U6): "What is Solana Bytes?" and
    "How it works". Mockup-driven content; copy stays terse to fit the
    Press Start 2P density. %>
<div class="mb-20">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Left card: what the product is %>
    <div class="pixel-card" style="padding:24px">
      <h2 class="text-white mb-4" style="font-size:18px;text-shadow:3px 3px 0 #4c1d95">
        <%= t("home.what_title") %>
      </h2>
      <p class="text-gray-300 mb-4" style="font-size:11px;line-height:1.8">
        <%= t("home.what_body") %>
      </p>
      <a href="<%= loc("/about") %>" class="text-purple-400 hover:text-purple-300 inline-flex items-center gap-2"
         style="font-size:10px"
         data-turbo="false">
        <%= t("home.learn_more") %> <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <%# Right card: three-step "How it works" %>
    <div class="pixel-card" style="padding:24px">
      <h2 class="text-white mb-4" style="font-size:18px;text-shadow:3px 3px 0 #4c1d95">
        <%= t("home.how_title") %>
      </h2>
      <ol class="space-y-3 text-gray-300" style="font-size:11px;line-height:1.7">
        <li class="flex items-start gap-3">
          <span class="text-purple-400 shrink-0" style="font-size:10px;min-width:14px">01</span>
          <span><%= t("home.how_step1") %></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-purple-400 shrink-0" style="font-size:10px;min-width:14px">02</span>
          <span><%= t("home.how_step2") %></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-purple-400 shrink-0" style="font-size:10px;min-width:14px">03</span>
          <span><%= t("home.how_step3") %></span>
        </li>
      </ol>
    </div>
  </div>
</div>
