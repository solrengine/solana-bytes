<% content_for(:title, "#{t('about.title')} — Solana Bytes") %>

<div class="max-w-5xl mx-auto">
  <div class="text-center mb-10">
    <h1 class="text-white mb-2" style="font-size:24px;text-shadow:4px 4px 0 #4c1d95"><%= t("about.title") %></h1>
    <p class="text-purple-300" style="font-size:13px">
      <%= t("home.tagline") %>
    </p>
  </div>

  <%# 2×2 grid of content boxes: What | Why on top, Who | Tech on bottom.
      Stacks single-column on mobile. %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
    <%# What %>
    <section class="pixel-card" style="padding:24px">
      <h2 class="text-white mb-3" style="font-size:14px;text-shadow:2px 2px 0 #4c1d95">
        <%= t("about.what_title") %>
      </h2>
      <p class="text-gray-300 mb-3" style="font-size:11px;line-height:1.9">
        <%= t("about.what_p1") %>
      </p>
      <p class="text-gray-400" style="font-size:11px;line-height:1.9">
        <%= t("about.what_p2") %>
      </p>
    </section>

    <%# Why %>
    <section class="pixel-card" style="padding:24px">
      <h2 class="text-white mb-3" style="font-size:14px;text-shadow:2px 2px 0 #4c1d95">
        <%= t("about.why_title") %>
      </h2>
      <p class="text-gray-300 mb-3" style="font-size:11px;line-height:1.9">
        <%= t("about.why_p1_html") %>
      </p>
      <p class="text-gray-400" style="font-size:11px;line-height:1.9">
        <%= t("about.why_p2") %>
      </p>
    </section>

    <%# Who %>
    <section class="pixel-card" style="padding:24px">
      <h2 class="text-white mb-3" style="font-size:14px;text-shadow:2px 2px 0 #4c1d95">
        <%= t("about.who_title") %>
      </h2>
      <p class="text-gray-300 mb-3" style="font-size:11px;line-height:1.9">
        <%= t("about.who_p1_html") %>
      </p>
      <p class="text-gray-400 mb-3" style="font-size:11px;line-height:1.9">
        <%= t("about.who_p2") %>
      </p>
      <p class="text-gray-400" style="font-size:11px;line-height:1.9">
        <%= t("about.who_p3_html") %>
      </p>
    </section>

    <%# Tech stack %>
    <section class="pixel-card" style="padding:24px">
      <h2 class="text-white mb-3" style="font-size:14px;text-shadow:2px 2px 0 #4c1d95">
        <%= t("about.tech_title") %>
      </h2>
      <ul class="space-y-2 text-gray-300" style="font-size:10px;line-height:1.8">
        <li><span class="text-purple-300">Rails 8.1</span> &middot; Hotwire (Turbo + Stimulus) &middot; Tailwind v4</li>
        <li><span class="text-purple-300">SolRengine</span> &middot; wallet auth (SIWS) + RPC client + account decoders</li>
        <li><span class="text-purple-300">SQLite</span> + Solid Queue / Cache / Cable</li>
        <li><span class="text-purple-300">Press Start 2P</span> font &middot; inline SVG pixel sprites &middot; pixel-art everywhere</li>
        <li><span class="text-purple-300">Kamal</span> for deploys</li>
      </ul>
    </section>
  </div>

  <%# Links — full-width band at the bottom %>
  <section class="pixel-card" style="padding:24px">
    <h2 class="text-white mb-3" style="font-size:14px;text-shadow:2px 2px 0 #4c1d95">
      <%= t("about.links_title") %>
    </h2>
    <div class="flex flex-wrap items-center gap-4">
      <a href="https://github.com/solrengine/solana-bytes" target="_blank" rel="noopener"
         class="text-purple-400 hover:text-purple-300 inline-flex items-center gap-2" style="font-size:11px">
        <%= pixel_icon(:github, size: 14) %>
        <%= t("about.github_repo") %>
      </a>
      <a href="https://solrengine.org" target="_blank" rel="noopener"
         class="text-purple-400 hover:text-purple-300" style="font-size:11px">
        SolRengine
      </a>
    </div>
  </section>
</div>
