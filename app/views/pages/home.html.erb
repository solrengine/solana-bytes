<% content_for :hide_navbar, "true" %>
<div data-controller="loading">
  <div data-loading-target="hero">
    <%# Hero band — logo on the left, Learn + Challenge CTAs on the right.
        Title / tagline / supporting copy / search stay centered below. %>
    <div class="pt-8 mb-16 flex items-center justify-between gap-6 flex-wrap">
      <%= pixel_logo(variant: :dark, size: 128, css_class: "shrink-0") %>

      <div class="flex items-center gap-3 sm:gap-4">
        <%= link_to loc("/learn"),
              class: "pixel-btn pixel-btn-secondary inline-flex items-center gap-2",
              style: "font-size:11px;padding:12px 18px" do %>
          <%= pixel_icon(:book, size: 16) %>
          <span><%= t("nav.learn") %></span>
        <% end %>
        <%= link_to loc("/challenges"),
              class: "pixel-btn inline-flex items-center gap-2",
              style: "font-size:11px;padding:12px 18px" do %>
          <%= pixel_icon(:target, size: 16) %>
          <span><%= t("nav.challenge") %></span>
        <% end %>
      </div>
    </div>

    <%# Title + tagline + supporting copy + search, centered below. %>
    <div class="mb-20 text-center">
      <h1 class="mb-5 text-white text-[28px] md:text-[44px] lg:text-[56px]" style="text-shadow:4px 4px 0 #4c1d95;line-height:1.2">
        Solana Bytes
      </h1>

      <p class="text-purple-300 text-[15px] md:text-[18px] lg:text-[20px] mb-4">
        <%= t("home.tagline") %>
      </p>

      <p class="text-gray-400 max-w-2xl mx-auto" style="font-size:12px;line-height:1.9">
        <%= t("home.subtitle") %>
      </p>

      <div class="mt-10 max-w-3xl mx-auto">
        <%= render "pages/paste_address_form" %>
      </div>
    </div>

    <%# Live decode sample — the product itself, right below the hero. A
        real mainnet account rendered through the same pipeline as the
        explorer (compact hex view, hover tooltips work). Hidden entirely
        if the cached RPC fetch fails. %>
    <% if @featured_account %>
      <div class="mb-20">
        <p class="text-center text-purple-300 mb-2" style="font-size:13px;letter-spacing:0.12em">
          <%= t("home.live_decode_label") %>
        </p>
        <p class="text-center text-gray-500 mb-8" style="font-size:10px">
          <%= t("home.live_decode_caption") %>
        </p>

        <div class="pixel-card max-w-3xl mx-auto" style="padding:20px">
          <div class="flex items-center justify-between gap-3 mb-5 flex-wrap">
            <span class="text-white" style="font-size:11px">
              USDC Mint · <%= @featured_account.owner_label %> · <%= @featured_account.data_length %> bytes
            </span>
            <%= link_to loc("/accounts/#{PagesController::FEATURED_ACCOUNT_ADDRESS}"),
                  data: { turbo_frame: "account_result" },
                  class: "text-purple-400 hover:text-purple-300",
                  style: "font-size:10px" do %>
              <%= t("home.live_decode_cta") %>
            <% end %>
          </div>
          <%= render "accounts/hex_view", account: @featured_account, compact: true %>
        </div>
      </div>
    <% end %>

    <%= render "pages/intro_cards" %>

    <%= render "pages/public_stats_banner", stats: @public_stats %>

    <%= render "pages/type_grid", stats: @public_stats %>

    <%= render "pages/endorsements" %>
  </div>

  <%# Loading state — mockup-style card that replaces the hero while the
      Turbo Frame fetches. Driven by loading_controller targets (no changes
      to the controller). %>
  <div data-loading-target="spinner" class="items-center justify-center min-h-[40vh]" style="display:none">
    <div class="pixel-card max-w-2xl mx-auto" style="padding:24px">
      <div class="flex items-center gap-4">
        <div class="text-purple-400 shrink-0">
          <%= pixel_icon(:magnifier, size: 24) %>
        </div>
        <div>
          <p class="text-white mb-2" style="font-size:12px">
            <span class="pixel-loading"><%= t("home.fetching") %></span>
          </p>
          <p class="text-gray-500" style="font-size:10px;line-height:1.6">
            <%= t("home.fetching_caption") %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <%# Results load here %>
  <%= turbo_frame_tag "account_result", data: { turbo_action: "advance", loading_target: "frame" } do %>
  <% end %>
</div>
