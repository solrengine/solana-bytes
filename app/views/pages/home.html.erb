<%= content_for :hex_rain, true %>

<div data-controller="loading">
  <div data-loading-target="hero" class="flex flex-col items-center justify-center min-h-[80vh]">
    <div class="text-center mb-10">
      <h1 class="mb-4" style="font-size:20px">
        <span class="text-purple-400">0x</span> Solana Bytes
      </h1>
      <p class="text-gray-400 max-w-xl mx-auto" style="font-size:12px;line-height:2">
        Paste any Solana account address to visualize its data as an interactive, color-coded hex dump.
      </p>
    </div>

    <div class="w-full max-w-2xl" data-controller="address-form">
      <%= form_with url: lookup_path, method: :post, data: { turbo_frame: "account_result", action: "submit->address-form#submit" } do |f| %>
        <div class="flex gap-3">
          <%= f.text_field :address,
                placeholder: "Enter address...",
                class: "flex-1 pixel-input",
                style: "font-size:12px;padding:14px 16px",
                autocomplete: "off",
                autofocus: true,
                data: { address_form_target: "input", action: "input->address-form#validate" } %>
          <button
            type="submit"
            disabled="disabled"
            data-address-form-target="submit"
            class="pixel-btn"
            style="font-size:12px;opacity:0.4;cursor:not-allowed"
          >
            Visualize
          </button>
        </div>
        <p data-address-form-target="error" class="text-red-400 mt-2" style="display:none;font-size:10px"></p>
      <% end %>

      <div class="mt-8">
        <p class="text-gray-500 mb-3" style="font-size:10px">Try an example:</p>
        <div class="flex flex-wrap gap-2">
          <% AccountsController::EXAMPLE_ADDRESSES.each do |example| %>
            <%= link_to account_path(address: example[:address]),
                  data: { turbo_frame: "account_result" },
                  class: "bg-gray-900 border-2 border-gray-700 px-3 py-2 text-gray-400 hover:text-purple-400 hover:border-purple-500",
                  style: "font-size:10px" do %>
              <span class="text-gray-500"><%= example[:label] %></span>
              <span class="ml-1"><%= example[:address][0..7] %>...</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Loading spinner %>
  <div data-loading-target="spinner" class="items-center justify-center min-h-[40vh]" style="display:none">
    <div class="text-center">
      <div class="text-purple-400 mb-4" style="font-size:16px">...</div>
      <p class="text-gray-400" style="font-size:12px">Fetching account data...</p>
    </div>
  </div>

  <%# Results load here %>
  <%= turbo_frame_tag "account_result", data: { turbo_action: "advance", loading_target: "frame" } do %>
  <% end %>
</div>
