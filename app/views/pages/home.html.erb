<% content_for :hide_navbar, "true" %>
<div data-controller="loading">
  <div data-loading-target="hero">
    <%# Hero band — 2-column on desktop (text + live decoded mint), stacks on mobile. %>
    <div class="pt-2 mb-12">
      <%# 2-column on desktop (text + live decode), stacks on mobile %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <%# Left: copy, left-aligned on desktop, centered on mobile %>
        <div class="text-center md:text-left">
          <h1 class="mb-3 text-white text-[20px] md:text-[32px] lg:text-[40px]" style="text-shadow:3px 3px 0 #4c1d95;line-height:1.2">
            Solana Bytes
          </h1>
          <p class="text-purple-300 text-[13px] md:text-[15px] lg:text-[16px]">
            A field guide to Solana accounts.
          </p>
          <p class="hidden md:block text-gray-400 text-[12px] mt-4" style="line-height:1.9">
            Most tools tell you what bytes mean. Solana Bytes shows you, and lets you prove you understand.
          </p>

          <%# Three-promise bullets that preview the bento tiles below
              and gloss what the live-decoded sample on the right is showing.
              Desktop only (matches the body paragraph above). %>
          <ul class="hidden md:block mt-6 space-y-2 text-gray-400" style="font-size:12px">
            <li class="flex items-center gap-3">
              <%= pixel_icon(:magnifier, size: 12) %>
              <span>Hover any byte to decode it</span>
            </li>
            <li class="flex items-center gap-3">
              <%= pixel_icon(:lock, size: 12) %>
              <span>Browse <%= AccountTaxonomy.flat_entries.length %> account types</span>
            </li>
            <li class="flex items-center gap-3">
              <%= pixel_icon(:target, size: 12) %>
              <span>Hunt the field in raw hex</span>
            </li>
          </ul>
        </div>

        <%# Right: live-decoded hero — only renders when the cached/fetched sample is available %>
        <% if @featured_account %>
          <%= render "hero_decoded_sample", account: @featured_account %>
        <% end %>
      </div>
    </div>

    <%= render "pages/endorsements" %>

    <%= render "pages/paste_address_form" %>

    <%= render "pages/type_picker", stats: @public_stats %>

    <%= render "pages/public_stats_banner", stats: @public_stats %>
  </div>

  <%# Loading spinner %>
  <div data-loading-target="spinner" class="items-center justify-center min-h-[40vh]" style="display:none">
    <div class="text-center">
      <div class="text-purple-400 mb-4" style="font-size:16px">...</div>
      <p class="text-gray-400" style="font-size:12px">Fetching account data...</p>
    </div>
  </div>

  <%# Results load here %>
  <%= turbo_frame_tag "account_result", data: { turbo_action: "advance", loading_target: "frame" } do %>
  <% end %>
</div>
