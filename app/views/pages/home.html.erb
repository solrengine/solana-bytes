<% content_for :hide_navbar, "true" %>
<div data-controller="loading">
  <div data-loading-target="hero">
    <%# Hero band — centered logo + title + tagline + supporting copy + search.
        Replaces the prior 2-column (text + live decoded mint) layout. The
        live-decoded sample retired with _hero_decoded_sample.html.erb. %>
    <div class="pt-8 mb-12 text-center">
      <%= pixel_logo(variant: :dark, size: 128, css_class: "mx-auto mb-6") %>

      <h1 class="mb-4 text-white text-[24px] md:text-[36px] lg:text-[44px]" style="text-shadow:4px 4px 0 #4c1d95;line-height:1.2">
        Solana Bytes
      </h1>

      <p class="text-purple-300 text-[14px] md:text-[16px] lg:text-[18px] mb-3">
        A field guide to Solana accounts.
      </p>

      <p class="text-gray-400 max-w-2xl mx-auto" style="font-size:11px;line-height:1.9">
        Inspect and understand raw Solana account bytes, structures, and on-chain data.
      </p>

      <div class="mt-8 max-w-3xl mx-auto">
        <%= render "pages/paste_address_form" %>
      </div>
    </div>

    <%= render "pages/intro_cards" %>

    <%= render "pages/public_stats_banner", stats: @public_stats %>

    <%= render "pages/type_grid", stats: @public_stats %>

    <%= render "pages/endorsements" %>
  </div>

  <%# Loading state — mockup-style card that replaces the hero while the
      Turbo Frame fetches. Driven by loading_controller targets (no changes
      to the controller). %>
  <div data-loading-target="spinner" class="items-center justify-center min-h-[40vh]" style="display:none">
    <div class="pixel-card max-w-2xl mx-auto" style="padding:24px">
      <div class="flex items-center gap-4">
        <div class="text-purple-400 shrink-0">
          <%= pixel_icon(:magnifier, size: 24) %>
        </div>
        <div>
          <p class="text-white mb-2" style="font-size:12px">
            <span class="pixel-loading">Fetching account from Solana</span>
          </p>
          <p class="text-gray-500" style="font-size:10px;line-height:1.6">
            This may take a few seconds.
          </p>
        </div>
      </div>
    </div>
  </div>

  <%# Results load here %>
  <%= turbo_frame_tag "account_result", data: { turbo_action: "advance", loading_target: "frame" } do %>
  <% end %>
</div>
