<%# Type-picker grid. Iterates AccountTaxonomy.flat_entries and renders
    one pixel-card per account type. Each card links to its example
    address (Turbo Frame inline decode). Replaces the prior Visualize +
    Learn + Play bento. %>
<div class="mb-12">
  <p class="text-center text-gray-500 mb-6" style="font-size:10px">
    — or pick a type to decode —
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% AccountTaxonomy.flat_entries.each do |entry| %>
      <%= link_to "/accounts/#{entry.example_address}",
            data: { turbo_frame: "account_result" },
            class: "pixel-card flex flex-col hover:border-purple-500 transition-colors",
            style: "padding:14px;text-decoration:none" do %>
        <h3 class="text-white mb-1" style="font-size:13px">
          <%= entry.name %>
        </h3>
        <p class="text-gray-500 mb-3" style="font-size:9px">
          <%= entry.program_label %><% if entry.size %> &middot; <%= entry.size %> bytes<% end %>
        </p>
        <p class="text-gray-400 mb-3" style="font-size:10px;line-height:1.6;flex:1">
          <%= truncate(entry.description, length: 110) %>
        </p>
        <p class="mt-auto text-purple-400" style="font-size:10px">
          Try <%= entry.example_label %> &rarr;
        </p>
      <% end %>
    <% end %>
  </div>

  <%# Secondary nav (taxonomy) + Byte Challenge CTA with live count.
      The challenge gets its own line and pixel-btn-secondary styling so
      it reads as an action, not just a footnote. The count pulls from
      `stats` when available and falls back to a plain hook otherwise. %>
  <div class="text-center mt-8">
    <%= link_to "/types",
          class: "text-gray-400 hover:text-purple-300 inline-flex items-center gap-2",
          style: "font-size:10px",
          data: { turbo: false } do %>
      <%= pixel_icon(:lock, size: 12) %> Browse the full taxonomy &rarr;
    <% end %>
  </div>

  <% challenges_count = local_assigns[:stats] && stats[:total_challenges].to_i %>
  <div class="text-center mt-4">
    <%= link_to "/challenges",
          class: "pixel-btn pixel-btn-secondary inline-flex items-center gap-2",
          style: "font-size:10px;padding:10px 18px",
          data: { turbo: false } do %>
      <%= pixel_icon(:target, size: 14) %>
      <% if challenges_count.to_i > 0 %>
        <span><%= number_with_delimiter(challenges_count) %> challenges played &mdash; can you beat them?</span>
      <% else %>
        <span>Test your eye &mdash; find the mint authority in 165 bytes</span>
      <% end %>
      <span>&rarr;</span>
    <% end %>
  </div>
</div>
