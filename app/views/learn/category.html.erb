<% content_for(:title, "#{@category.name} — Learn — Solana Bytes") %>

<div class="max-w-5xl mx-auto">
  <%# Breadcrumb back to Learn directory %>
  <nav class="mb-6">
    <%= link_to "/learn", class: "text-gray-500 hover:text-purple-400 inline-flex items-center gap-2", style: "font-size:10px" do %>
      <span aria-hidden="true">&larr;</span> Learn
    <% end %>
  </nav>

  <div class="mb-10">
    <h1 class="text-white mb-3" style="font-size:24px;text-shadow:4px 4px 0 #4c1d95">
      <%= @category.name %>
    </h1>
    <p class="text-gray-400 max-w-2xl" style="font-size:11px;line-height:1.8">
      <%= @category.description %>
    </p>
  </div>

  <% if @live.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
      <% @live.each do |entry| %>
        <%= link_to entry.learn_path,
              class: "pixel-card flex flex-col hover:border-purple-500 transition-colors",
              style: "padding:18px;text-decoration:none" do %>
          <h2 class="text-white mb-1" style="font-size:14px">
            <%= entry.name %>
          </h2>
          <p class="text-gray-500 mb-3" style="font-size:9px">
            <%= entry.program_label %><% if entry.size %> &middot; <%= entry.size %> bytes<% end %>
          </p>
          <p class="text-gray-400 mb-4" style="font-size:10px;line-height:1.7;flex:1">
            <%= entry.summary %>
          </p>
          <p class="mt-auto text-purple-400" style="font-size:10px">
            Explore <span aria-hidden="true">&rarr;</span>
          </p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @drafts.any? %>
    <div class="border-t-2 border-gray-800 pt-8">
      <h2 class="text-white mb-2" style="font-size:14px;text-shadow:2px 2px 0 #4c1d95">
        Draft entries
      </h2>
      <p class="text-gray-500 mb-6" style="font-size:10px">
        These pages have byte layouts and examples; the prose is still
        being written.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <% @drafts.each do |entry| %>
          <%= link_to entry.learn_path,
                class: "pixel-card flex items-start gap-3 hover:border-purple-500 transition-colors",
                style: "padding:14px;text-decoration:none" do %>
            <div class="flex-1">
              <p class="text-white" style="font-size:11px"><%= entry.name %></p>
              <p class="text-gray-500 mt-1" style="font-size:9px">
                <%= entry.program_label %><% if entry.size %> &middot; <%= entry.size %> bytes<% end %>
              </p>
            </div>
            <span class="text-purple-400 shrink-0" style="font-size:10px">Draft &rarr;</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @live.empty? && @drafts.empty? %>
    <div class="pixel-card text-center" style="padding:24px">
      <p class="text-gray-400" style="font-size:11px">
        No entries in this category yet.
      </p>
    </div>
  <% end %>
</div>
