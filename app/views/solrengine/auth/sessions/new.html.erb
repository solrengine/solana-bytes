<div class="flex items-center justify-center min-h-[70vh]">
  <div class="max-w-sm w-full mx-4" data-controller="wallet" data-wallet-nonce-url-value="<%= solrengine_auth.nonce_path %>" data-wallet-verify-url-value="<%= solrengine_auth.verify_path %>" data-wallet-dashboard-url-value="<%= Solrengine::Auth.configuration.after_sign_in_path %>">

    <div class="text-center mb-8">
      <div class="text-5xl mb-4">🔐</div>
      <h1 class="text-3xl font-bold text-white mb-2">Connect Wallet</h1>
      <p class="text-gray-400 text-sm">Sign in to save your scores and appear on the leaderboard</p>
    </div>

    <div class="bg-gray-800/30 backdrop-blur border border-gray-700/50 rounded-2xl p-6 shadow-xl">
      <div data-wallet-target="status" class="hidden mb-4 p-3 rounded-lg text-sm text-center"></div>

      <div data-wallet-target="walletList" class="hidden mb-4 space-y-2"></div>

      <button
        data-wallet-target="connectBtn"
        data-action="click->wallet#authenticate"
        class="w-full cursor-pointer bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-200 flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        Connect Wallet
      </button>

      <div data-wallet-target="signing" class="hidden">
        <div class="text-center">
          <div class="animate-spin w-8 h-8 border-2 border-purple-500 border-t-transparent rounded-full mx-auto mb-3"></div>
          <p class="text-gray-300 text-sm">Approve the sign-in request in your wallet...</p>
        </div>
      </div>
    </div>

    <p class="text-center text-gray-600 text-xs mt-6">
      Powered by <a href="https://solrengine.org" class="text-purple-400/60 hover:text-purple-400 transition-colors">SolRengine</a>
    </p>
  </div>
</div>
