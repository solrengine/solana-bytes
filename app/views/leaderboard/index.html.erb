<% content_for(:title, "Leaderboard — Solana Bytes") %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold text-white">🏆 Leaderboard</h1>
    <%= link_to "Play", challenges_path, class: "text-purple-400 hover:text-purple-300 text-sm transition-colors" %>
  </div>

  <%# Top Streaks %>
  <div class="bg-gray-800/50 border border-gray-700/50 rounded-2xl overflow-hidden mb-8">
    <div class="px-5 py-3 border-b border-gray-700/50">
      <h2 class="text-lg font-semibold text-white">Top Streaks</h2>
    </div>

    <% if @top_streaks.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-gray-500 text-xs uppercase tracking-wider">
            <th class="text-left px-5 py-3">#</th>
            <th class="text-left px-5 py-3">Player</th>
            <th class="text-right px-5 py-3">Streak</th>
            <th class="text-right px-5 py-3">Stars</th>
            <th class="text-right px-5 py-3">Time</th>
            <th class="text-right px-5 py-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700/30">
          <% @top_streaks.each_with_index do |result, index| %>
            <tr class="hover:bg-gray-700/20 transition-colors">
              <td class="px-5 py-3">
                <span class="<%= index < 3 ? 'text-yellow-400 font-bold' : 'text-gray-500' %>">
                  <%= index == 0 ? '🥇' : index == 1 ? '🥈' : index == 2 ? '🥉' : (index + 1).to_s %>
                </span>
              </td>
              <td class="px-5 py-3">
                <span class="text-gray-300 font-mono text-xs"><%= result.user.short_address %></span>
              </td>
              <td class="px-5 py-3 text-right">
                <span class="text-yellow-400 font-bold">🔥 <%= result.streak %></span>
              </td>
              <td class="px-5 py-3 text-right">
                <span class="text-gray-400"><%= "⭐" * result.stars %></span>
              </td>
              <td class="px-5 py-3 text-right">
                <span class="text-gray-400 font-mono"><%= "%.1f" % result.time_seconds %>s</span>
              </td>
              <td class="px-5 py-3 text-right">
                <span class="text-gray-500 text-xs"><%= result.created_at.strftime("%b %d") %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-10 text-center">
        <p class="text-gray-400">No challenges completed yet</p>
        <p class="text-gray-500 text-xs mt-1"><%= link_to "Be the first!", challenges_path, class: "text-purple-400 hover:text-purple-300" %></p>
      </div>
    <% end %>
  </div>

  <%# Recent Games %>
  <div class="bg-gray-800/50 border border-gray-700/50 rounded-2xl overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-700/50">
      <h2 class="text-lg font-semibold text-white">Recent Games</h2>
    </div>

    <% if @recent_games.any? %>
      <div class="divide-y divide-gray-700/30">
        <% @recent_games.each do |result| %>
          <div class="px-5 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="text-gray-300 font-mono text-xs"><%= result.user.short_address %></span>
              <span class="text-gray-500 text-xs">found <span class="text-purple-400"><%= result.target_field %></span></span>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-yellow-400 text-sm">🔥 <%= result.streak %></span>
              <span class="text-gray-500 text-xs"><%= time_ago_in_words(result.created_at) %> ago</span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-10 text-center">
        <p class="text-gray-400">No games yet</p>
      </div>
    <% end %>
  </div>
</div>
