<% content_for(:title, "Byte Challenge — Solana Bytes") %>
<% content_for(:hex_rain) { "" } %>

<div class="flex flex-col items-center justify-center min-h-[60vh]">
  <div class="text-center max-w-lg">
    <div class="text-6xl mb-6">🎯</div>
    <h1 class="text-4xl font-bold text-white mb-4">Byte Challenge</h1>
    <p class="text-gray-400 text-lg mb-2">
      Can you find the right bytes in a Solana account?
    </p>
    <p class="text-gray-500 mb-10">
      We'll show you an account's hex dump and ask you to click on a specific field.
      The faster you find it, the higher your score.
    </p>

    <%= link_to challenge_path, class: "inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-4 px-8 rounded-xl transition-all duration-200 text-lg" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Start Challenge
    <% end %>

    <div class="mt-8 text-gray-600 text-sm">
      <p>Test your knowledge of Solana account data structures</p>
    </div>
  </div>
</div>
