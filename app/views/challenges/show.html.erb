<% content_for(:title, "Byte Challenge — Solana Bytes") %>

<div data-controller="challenge"
     data-challenge-target-region-value="<%= @target_region.id %>"
     data-challenge-target-name-value="<%= @target_region.name %>"
     data-challenge-target-decoded-value="<%= @target_region.decoded_value %>"
     data-challenge-streak-value="<%= @streak %>"
     data-challenge-max-wrong-value="<%= @max_wrong %>"
     data-challenge-save-url-value="/challenge/result"
     data-challenge-next-url-value="/challenge"
     data-challenge-account-address-value="<%= @address %>"
     data-challenge-logged-in-value="<%= logged_in? %>">

  <%# Challenge prompt %>
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">🎯</span>
          <h1 class="text-xl font-bold text-white">Find the bytes for:</h1>
        </div>
        <div class="bg-purple-900/30 border border-purple-700/50 rounded-xl px-5 py-3 inline-block">
          <span class="text-purple-300 text-lg font-semibold font-mono" data-challenge-target="fieldName"><%= @target_region.name %></span>
        </div>
      </div>
      <div class="flex items-center gap-6">
        <% if @streak > 0 %>
          <div class="text-right">
            <div class="text-gray-500 text-xs mb-1">Streak</div>
            <div class="text-2xl font-bold text-yellow-400 font-mono">🔥 <%= @streak %></div>
          </div>
        <% end %>
        <div class="text-right">
          <div class="text-gray-500 text-xs mb-1">Time</div>
          <div class="text-2xl font-bold text-white font-mono" data-challenge-target="timer">0.0s</div>
        </div>
        <div class="text-right">
          <div class="text-gray-500 text-xs mb-1">Lives</div>
          <div class="text-lg font-mono" data-challenge-target="lives">❤️❤️❤️</div>
        </div>
      </div>
    </div>
  </div>

  <%# Metadata bar %>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm mb-4 text-gray-400">
    <span>Account: <span class="text-gray-300 font-mono"><%= @address[0..7] %>...<%= @address[-4..] %></span></span>
    <span>Size: <span class="text-gray-300"><%= number_with_delimiter(@account.raw_bytes.length) %> bytes</span></span>
    <%= link_to "Skip →", "/challenge", class: "text-gray-500 hover:text-white transition-colors ml-auto" %>
  </div>

  <%# Hex grid %>
  <div data-controller="hex-viewer">
    <% if @account.truncated %>
      <div class="text-xs text-yellow-500 mb-3">
        showing <%= number_with_delimiter(@account.raw_bytes.length) %> of <%= number_with_delimiter(@account.truncated) %> bytes
      </div>
    <% end %>

    <%# Tooltip %>
    <div
      data-hex-viewer-target="tooltip"
      style="display:none;position:fixed;z-index:50;background:#0a0a0f;border:1px solid #2d1b69;border-radius:4px;padding:8px 12px;font-size:13px;font-family:'JetBrains Mono',ui-monospace,monospace;box-shadow:0 8px 32px rgba(0,0,0,0.8);pointer-events:none;max-width:400px"
    >
    </div>

    <%# Hex Grid — all cells same gray color (challenge mode) %>
    <div class="overflow-x-auto">
      <table class="w-full" style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:14px;line-height:2.0">
        <thead>
          <tr>
            <th class="text-left pr-4 pb-3 font-normal text-gray-600 text-sm"></th>
            <% 16.times do |i| %>
              <th class="px-1 pb-3 font-normal text-center text-gray-600 text-sm"><%= format("%X", i) %></th>
            <% end %>
            <th class="pl-6 pb-3 font-normal text-left text-gray-600 text-sm"></th>
          </tr>
        </thead>
        <tbody>
          <% @account.hex_rows.each do |row| %>
            <tr>
              <td class="text-gray-600 pr-4 select-none text-sm"><%= row.offset_hex %></td>
              <% row.cells.each do |cell| %>
                <td
                  class="px-1 text-center cursor-pointer hover:bg-gray-700/50 transition-colors"
                  style="color:#9ca3af;background:#111318;border-radius:2px"
                  data-hex-viewer-target="cell"
                  data-action="click->challenge#guess"
                  data-region="<%= cell.region_id %>"
                  data-offset="<%= cell.offset %>"
                  data-value="<%= cell.hex %>"
                  data-decimal="<%= cell.byte %>"
                  data-base-color="<%= cell.text_color %>"
                  data-base-bg="<%= cell.bg_color %>"
                  <% if cell.region %>
                    data-region-name="<%= cell.region.name %>"
                    data-region-decoded="<%= cell.region.decoded_value %>"
                    data-region-start="<%= cell.region.start %>"
                    data-region-length="<%= cell.region.length %>"
                  <% end %>
                ><%= cell.hex %></td>
              <% end %>
              <% row.padding_cells.times do %>
                <td class="px-1"></td>
              <% end %>
              <td class="pl-6 text-gray-500 select-none whitespace-pre text-sm"><%= row.ascii %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# Wrong click toast (brief centered popup) %>
  <div data-challenge-target="toast" class="hidden fixed inset-0 flex items-center justify-center pointer-events-none" style="z-index:90">
    <div data-challenge-target="toastContent" class="bg-gray-900 border border-red-700/50 rounded-2xl px-8 py-6 text-center"></div>
  </div>

  <%# Result modal (shown on correct/game over) %>
  <div data-challenge-target="modal" class="hidden fixed inset-0 flex items-center justify-center" style="z-index:100">
    <div class="absolute inset-0 bg-black/80 backdrop-blur"></div>
    <div data-challenge-target="modalContent" class="relative max-w-sm w-full mx-4 rounded-2xl p-8 text-center"></div>
  </div>
</div>
