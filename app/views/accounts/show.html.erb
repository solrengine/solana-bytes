<%= turbo_frame_tag "account_result", data: { turbo_action: "advance" } do %>
  <div class="max-w-6xl mx-auto mt-2">
    <%# Address + back %>
    <div class="flex items-start justify-between gap-4 mb-5">
      <p class="text-green-400 break-all" style="font-size:8px"><%= @account.address %></p>
      <%= link_to root_path, class: "text-gray-500 hover:text-purple-400 shrink-0", style: "font-size:8px", data: { turbo_frame: "account_result", turbo_action: "advance" } do %>
        << back
      <% end %>
    </div>

    <%# Metadata %>
    <div class="flex flex-wrap gap-x-6 gap-y-2 mb-6 pb-5 border-b-2 border-gray-800" style="font-size:8px">
      <div>
        <span class="text-gray-400">bal</span>
        <span class="text-white ml-1"><%= number_with_precision(@account.balance_sol, precision: 9, strip_insignificant_zeros: true) %></span>
        <span class="text-gray-500 ml-0.5">SOL</span>
      </div>
      <div>
        <span class="text-gray-400">owner</span>
        <span class="text-purple-300 ml-1" title="<%= @account.owner %>"><%= @account.owner_label %></span>
      </div>
      <div>
        <span class="text-gray-400">exec</span>
        <% if @account.executable %>
          <span class="text-orange-400 ml-1">true</span>
        <% else %>
          <span class="text-gray-500 ml-1">false</span>
        <% end %>
      </div>
      <div>
        <span class="text-gray-400">size</span>
        <span class="text-gray-200 ml-1"><%= number_with_delimiter(@account.data_length) %></span>
        <span class="text-gray-500 ml-0.5">bytes</span>
      </div>
    </div>

    <%# Hex View %>
    <% if @account.raw_bytes.any? %>
      <%= render "accounts/hex_view", account: @account %>
    <% else %>
      <div class="text-gray-500 py-12 text-center" style="font-size:8px">
        no data bytes
      </div>
    <% end %>
  </div>
<% end %>
