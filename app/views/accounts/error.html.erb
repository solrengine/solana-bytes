<%= turbo_frame_tag "account_result" do %>
  <div class="flex flex-col items-center justify-center min-h-[40vh]">
    <div class="bg-gray-800/50 backdrop-blur border border-gray-700/50 rounded-2xl p-8 text-center max-w-md">
      <p class="text-gray-300 mb-6"><%= flash[:alert] %></p>
      <% if @address.present? %>
        <p class="font-mono text-xs text-gray-500 mb-6 break-all"><%= @address %></p>
      <% end %>
      <%= link_to "Try another address", root_path,
            class: "inline-block bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold px-6 py-3 rounded-xl transition-all",
            data: { turbo_frame: "account_result", turbo_action: "advance" } %>
    </div>
  </div>
<% end %>
