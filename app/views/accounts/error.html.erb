<%= turbo_frame_tag "account_result" do %>
  <div class="max-w-6xl mx-auto mt-4 font-mono">
    <div class="py-16 text-center">
      <p class="text-red-400 text-sm mb-2"><span class="text-red-600">ERR</span> <%= flash[:alert] %></p>
      <% if @address.present? %>
        <p class="text-xs text-gray-600 mb-8 break-all"><%= @address %></p>
      <% end %>
      <%= link_to root_path,
            class: "text-xs text-gray-500 hover:text-purple-400 transition-colors",
            data: { turbo_frame: "account_result", turbo_action: "advance" } do %>
        <span class="text-purple-500">$</span> cd ..
      <% end %>
    </div>
  </div>
<% end %>
