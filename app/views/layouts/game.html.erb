<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Solana Bytes — Interactive Account Hex Visualizer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-prefetch" content="false">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gray-950 text-gray-100">
    <div data-controller="hex-rain" class="fixed inset-0" style="z-index:0">
      <canvas data-hex-rain-target="canvas" class="w-full h-full"></canvas>
      <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at center, rgba(3,7,18,0.3) 0%, rgba(3,7,18,0.7) 50%, rgba(3,7,18,0.95) 100%)"></div>
    </div>

    <nav class="relative pixel-nav" style="z-index:10">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <%= link_to "/", class: "flex items-center gap-2 text-white hover:text-purple-400" do %>
          <span style="font-size:14px">Solana Bytes</span>
        <% end %>
        <div class="flex items-center gap-4">
          <%= link_to "/challenges", class: "text-purple-400 hover:text-purple-300 flex items-center gap-1", style: "font-size:12px" do %>
            <%= pixel_icon(:target, size: 16) %> Challenge
          <% end %>
          <%= link_to "/leaderboard", class: "hover:opacity-80", style: "font-size:12px" do %>
            <%= pixel_icon(:trophy, size: 16) %>
          <% end %>
          <% if logged_in? %>
            <span class="text-gray-400 bg-gray-900 border-2 border-gray-700 px-2 py-1" style="font-size:10px"><%= current_user.short_address %></span>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <% if flash[:alert] %>
        <div class="mb-6 p-4 pixel-card text-red-400" style="border-color:#991b1b">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
