<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Solana Bytes — Interactive Account Hex Visualizer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Visualize Solana account data as interactive, color-coded hex dumps. Built with Rails 8 and SolRengine.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Solana Bytes">
    <meta name="mobile-web-app-capable" content="yes">

    <%# Open Graph %>
    <meta property="og:title" content="Solana Bytes — Interactive Hex Visualizer + Byte Challenge Game">
    <meta property="og:description" content="Visualize Solana account data as color-coded hex dumps. Play the Byte Challenge to test your knowledge of Solana data structures.">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://bytes.solrengine.org/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Solana Bytes — Interactive Hex Visualizer + Byte Challenge Game">
    <meta name="twitter:description" content="Visualize Solana account data as color-coded hex dumps. Play the Byte Challenge to test your knowledge of Solana data structures.">
    <meta name="twitter:image" content="https://bytes.solrengine.org/og.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-prefetch" content="false">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <%# Hide navbar on landing's hero state. The loading_controller toggles
        the .landing-hero-active class off when the user submits the form
        (so the navbar reappears on the result view) and back on when the
        user navigates home (so the hero reads cleanly again). %>
    <style>
      body.landing-hero-active nav.pixel-nav { display: none; }
      /* The nav (and its language switcher) is hidden on the landing
         hero, so surface a standalone switcher that shows only then. */
      .landing-lang-switch { display: none; }
      body.landing-hero-active .landing-lang-switch { display: inline-flex; }
    </style>
  </head>

  <body class="min-h-screen bg-gray-950 text-gray-100<%= ' landing-hero-active' if content_for?(:hide_navbar) %>">
    <%# Landing-only language switcher — visible when the navbar is hidden
        on the hero. Fixed top-right so it never collides with the hero. %>
    <%= link_to locale_switch_path(other_locale),
          class: "landing-lang-switch fixed top-4 right-4 text-gray-400 hover:text-white border-2 border-gray-700 hover:border-purple-500 px-2 py-1",
          style: "z-index:20;font-size:10px;background:#0a0a14",
          rel: "alternate", hreflang: other_locale.to_s do %><%= other_locale.to_s.upcase %><% end %>

    <%# Loading overlay — shown during challenge navigation %>
    <div id="game-loading" class="hidden fixed inset-0 flex items-center justify-center bg-black/80" style="z-index:200">
      <div class="text-center">
        <div class="text-purple-400 mb-4" style="font-size:14px">
          <span class="pixel-loading">Loading</span>
        </div>
        <div class="text-gray-500" style="font-size:10px">Fetching account from Solana...</div>
      </div>
    </div>

    <div data-controller="hex-rain" class="fixed inset-0" style="z-index:0">
      <canvas data-hex-rain-target="canvas" class="w-full h-full"></canvas>
      <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at center, rgba(3,7,18,0.3) 0%, rgba(3,7,18,0.7) 50%, rgba(3,7,18,0.95) 100%)"></div>
    </div>

    <nav class="relative pixel-nav" style="z-index:10">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-2">
        <%# Brand: pixel logo + wordmark. loc() keeps the link within the
            active locale; bare path for default (engine-isolation safe). %>
        <%= link_to loc("/"), class: "text-white hover:text-purple-400 shrink-0 flex items-center gap-3" do %>
          <%= pixel_logo(variant: :dark, size: 56) %>
          <span style="font-size:14px;text-shadow:3px 3px 0 #4c1d95" class="hidden sm:inline">Solana Bytes</span>
        <% end %>
        <div class="flex items-center gap-3 sm:gap-4">
          <%= link_to loc("/about"), class: "text-gray-500 hover:text-gray-300 hidden sm:inline", style: "font-size:10px" do %><%= t("nav.about") %><% end %>
          <%= link_to loc("/learn"), class: "text-gray-500 hover:text-gray-300 hidden sm:inline", style: "font-size:10px" do %><%= t("nav.learn") %><% end %>
          <%= link_to loc("/challenges"), class: "text-purple-400 hover:text-purple-300 flex items-center gap-1", style: "font-size:10px" do %>
            <%= pixel_icon(:target, size: 14) %><span class="hidden sm:inline"> <%= t("nav.challenge") %></span>
          <% end %>
          <%# Language switcher: links to the current page in the other locale. %>
          <%= link_to locale_switch_path(other_locale), class: "text-gray-500 hover:text-gray-300", style: "font-size:10px", rel: "alternate", hreflang: other_locale.to_s do %><%= other_locale.to_s.upcase %><% end %>
          <% if logged_in? %>
            <span class="text-gray-400 bg-gray-900 border-2 border-gray-700 px-2 py-1 hidden sm:inline" style="font-size:10px"><%= current_user.short_address %></span>
            <%= link_to "x", "/auth/logout", data: { turbo_method: :delete }, class: "text-gray-500 hover:text-white", style: "font-size:10px" %>
          <% end %>
          <%= form_with url: "/network", method: :patch, class: "hidden sm:flex items-center", data: { controller: "auto-submit", turbo_frame: "_top" } do |f| %>
            <%= f.select :network,
                  options_for_select(
                    [["Mainnet", "mainnet-beta"], ["Devnet", "devnet"], ["Testnet", "testnet"]],
                    session[:solana_network] || "mainnet-beta"
                  ),
                  {},
                  class: "pixel-input cursor-pointer",
                  style: "font-size:10px;padding:4px 8px;border-width:2px",
                  data: { action: "change->auto-submit#submit" } %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="relative max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-12 py-8" style="z-index:10">
      <% if flash[:alert] %>
        <div class="mb-6 p-4 pixel-card text-red-400" style="border-color:#991b1b">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="relative border-t-3 border-gray-800 mt-16" style="z-index:10">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
          <%# Left: brand mark + tagline (logo on the left, text stacked beside it) %>
          <div class="flex items-center gap-3">
            <%= pixel_logo(variant: :dark, size: 72, css_class: "shrink-0") %>
            <div>
              <p class="text-white" style="font-size:10px;text-shadow:2px 2px 0 #4c1d95">Solana Bytes</p>
              <p class="text-gray-500 mt-1" style="font-size:8px;line-height:1.6">A field guide to Solana accounts.</p>
            </div>
          </div>

          <%# Centre: nav links. Same set as the global nav: About / Learn /
              Challenge. Literal string paths for engine isolation. %>
          <div class="flex flex-col gap-2 text-center md:text-left text-gray-400">
            <a href="<%= loc("/about") %>" class="hover:text-purple-300" style="font-size:9px"><%= t("nav.about") %></a>
            <a href="<%= loc("/learn") %>" class="hover:text-purple-300" style="font-size:9px"><%= t("nav.learn") %></a>
            <a href="<%= loc("/challenges") %>" class="hover:text-purple-300" style="font-size:9px"><%= t("nav.challenge") %></a>
          </div>

          <%# Right: hackathon credit + SolRengine attribution. %>
          <div class="text-center md:text-right text-gray-600 flex flex-col gap-2 items-center md:items-end">
            <p style="font-size:8px;line-height:1.6">Built for Colosseum Frontier Hackathon</p>
            <p style="font-size:8px;line-height:1.6">
              Powered by <a href="https://solrengine.org" class="text-purple-400 hover:text-purple-300">SolRengine</a>
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
